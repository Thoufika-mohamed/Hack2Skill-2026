# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAQ Air Quality API Key
OPENAQ_API_KEY=your_openaq_api_key_here

# Firebase Service Account (In Render/Railway, paste the complete JSON contents of your firebase-service-account.json here as a single-line or multi-line string)
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
